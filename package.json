{
  "name": "campusmarkt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-unknown",
    "test:unit": "vitest run tests/unit packages --passWithNoTests",
    "test:architecture": "vitest run tests/architecture --passWithNoTests",
    "test:integration": "vitest run tests/integration/compose --passWithNoTests",
    "test:db": "vitest run supabase/tests --passWithNoTests",
    "test:stack": "vitest run tests/integration/stack --passWithNoTests",
    "test:operations": "vitest run tests/integration/operations --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:architecture",
    "verify": "npm run check && npm run build && npm run test:integration && npm run test:db && npm run test:stack && npm run test:operations && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
